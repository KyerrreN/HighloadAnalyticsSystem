{
  "realm": "telemetry",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard telemetry user"
      },
      {
        "name": "admin",
        "description": "Administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "telemetry-management-api",
      "name": "Telemetry Management API",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "secret": "GFrh8EL8hGcZmOiolt9i95n9ug9ocSIMOIeYM7gH0SQmDoIxTMFLubBeYeA5RcSpru3Urh34rb0PBlPFa53zZi",
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "aud-mapper-telemetry-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "telemetry-management-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "devuser",
      "enabled": true,
      "email": "dev@telemetry.local",
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "service-account-telemetry-management-api",
      "enabled": true,
      "serviceAccountClientId": "telemetry-management-api",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
