{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "PartitionCount": 12,
    "ReplicationFactor": 1,
    "TopicName": "telemetry-events"
  },
  "RocksDb": {
    "ConnectionString": ""
  },
  "GrpcServices": {
    "UserManagementUrl": "http://localhost:5108"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "IngressCache:"
  },
  "Cache": {
    "MemoryCacheSizeLimit": 1000000,
    "CompactionPercentage": 0.2,
    "L1Duration": "00:02:00",
    "L2Duration": "1.00:00:00",
    "FailSafeThrottleDuration": "00:00:30"
  }
}
